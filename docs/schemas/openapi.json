  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "technical_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Technical Confirmed"
          },
          "internal_only": {
            "type": "boolean",
            "const": true,
            "title": "Internal Only"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "technical_confirmed",
          "internal_only",
          "note"
        ],
        "title": "ApproveRequest"
      },
      "ChangeInputs": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "inputs": {
            "$ref": "#/components/schemas/ConfirmedInputs"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "inputs",
          "reason"
        ],
        "title": "ChangeInputs"
      },
      "ConfirmedInputs": {
        "properties": {
          "part_number": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Part Number"
          },
          "required_revision": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Required Revision"
          },
          "drawing_revision": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Drawing Revision"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "material": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Material"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": "mm"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "EUR"
          },
          "plant": {
            "type": "string",
            "title": "Plant",
            "default": "DE-DEMO"
          },
          "product_family": {
            "type": "string",
            "title": "Product Family",
            "default": "mounting-bracket"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "part_number",
          "required_revision",
          "drawing_revision",
          "quantity",
          "material"
        ],
        "title": "ConfirmedInputs",
        "description": "Explicitly confirmed M1 input; not a substitute for M2 file extraction."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Mutation": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "Mutation"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
