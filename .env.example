# Copy to .env.local; never commit credentials or use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Defaults are restricted to a local synthetic-data demonstration.
RFQ_DATA_DIR=var
RFQ_ALLOWED_ORIGIN=http://127.0.0.1:3000
RFQ_MODEL_TIMEOUT_SECONDS=60
# Set to 1 in an isolated demo to inject MODEL_TIMEOUT without a network call.
RFQ_SIMULATE_MODEL_TIMEOUT=0
# Optional absolute path; default config/model-pricing.json. Missing/expired tariff means unknown cost.
# RFQ_MODEL_PRICING_FILE=
RFQ_ENGINEER_TOKEN=
RFQ_APPROVER_TOKEN=
# Stateful simulated integrations (SIMULATED / NO EXTERNAL WRITE).
RFQ_SYNC_MAX_ATTEMPTS=5
RFQ_SYNC_LEASE_SECONDS=60
RFQ_SNAPSHOT_TTL_SECONDS=900
# RFQ_FAKE_SYSTEMS_PATH=var/fake-systems.sqlite3
# RFQ_SYNC_FAULT_PLAN=[{"method":"erp.put_draft","kind":"timeout_after_commit","times":1}]
