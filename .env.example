# Copy to .env.local; never commit credentials or use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Defaults are restricted to a local synthetic-data demonstration.
RFQ_DATA_DIR=var
RFQ_ALLOWED_ORIGIN=http://127.0.0.1:3000
RFQ_MODEL_TIMEOUT_SECONDS=60
RFQ_ENGINEER_TOKEN=
RFQ_APPROVER_TOKEN=
